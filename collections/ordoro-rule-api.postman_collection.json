          "id": "efa538ff-4211-41b4-b697-e8537f887944",
          "name": "Create a Rule",
          "request": {
            "name": "Create a Rule",
            "description": {
              "content": "Rules are used by the Automation Rules process in Ordoro. An `index` value determines where in the list the rule takes place. Rules have inner logic for determining an IF and THEN clause. Rules may only be run as an `order_created` latch at this time. The logic is obscured internally and this may be difficult to do via the API. We would suggest that you use the UI to make any updates to Rules",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rule",
                ""
              ],
              "host": [
                "{{baseUrl}}"
